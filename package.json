{
  "name": "@wiesinghilker/extension-lib-frontend",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wiesinghilker/extension-library-frontend.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/index.css": "./dist/index.css",
    "./e2e": {
      "types": "./dist/e2e.d.ts",
      "import": "./dist/e2e.js",
      "require": "./dist/e2e.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "version": "0.0.0",
  "scripts": {
    "lint": "eslint --fix 'src/**/*.{ts,tsx}' --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write src/**/* eslint.config.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "peerDependencies": {
    "@mittwald/ext-bridge": "^1",
    "@mittwald/flow-remote-react-components": "^1",
    "@playwright/test": "^1",
    "openapi-fetch": "^0",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7 || ^8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@mittwald/ext-bridge": "^1.0.4",
    "@mittwald/flow-remote-react-components": "^1.0.4",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "openapi-fetch": "^0.17.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0"
  }
}
