{
  "name": "@wiesinghilker/extension-lib-frontend",
  "type": "module",
  "packageManager": "pnpm@10.27.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wiesinghilker/extension-library-frontend.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dist/index.css": "./dist/index.css",
    "./e2e": {
      "types": "./dist/e2e.d.ts",
      "import": "./dist/e2e.js",
      "require": "./dist/e2e.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "version": "0.0.0",
  "scripts": {
    "lint": "eslint --fix 'src/**/*.{ts,tsx}' --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write src/**/* eslint.config.mjs",
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "peerDependencies": {
    "@mittwald/ext-bridge": "^0",
    "@mittwald/flow-remote-react-components": "^0",
    "@playwright/test": "^1",
    "openapi-fetch": "^0",
    "react": "^19",
    "react-dom": "^19",
    "react-router": "^7"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@mittwald/ext-bridge": "^0.2.0-alpha.665",
    "@mittwald/flow-remote-react-components": "^0.2.0-alpha.665",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.2",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.28.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^17.3.0",
    "openapi-fetch": "^0.15.0",
    "prettier": "^3.8.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
